# HyperCopy local development template. No real secret belongs in this file.
APP_ENV=development
APP_VERSION=dev
LOG_LEVEL=INFO
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://hypercopy:hypercopy@postgres:5432/hypercopy
REDIS_URL=redis://redis:6379/0

# Legacy fallback. New deployments should set MASTER/FOLLOWER explicitly.
HYPERLIQUID_NETWORK=testnet
HYPERLIQUID_MASTER_NETWORK=testnet
HYPERLIQUID_FOLLOWER_NETWORK=testnet
HYPERLIQUID_MASTER_ADDRESS=0x0000000000000000000000000000000000000000
HL_RATE_BUDGET_PER_MIN=1200
HL_ORDER_EXPIRES_AFTER_MS=15000
HL_AGENT_NAME=hypercopy
HL_MASTER_SNAPSHOT_TTL_SECONDS=2
HL_MASTER_SNAPSHOT_STALE_SECONDS=15
HL_WS_HEARTBEAT_SECONDS=30
HL_SAFE_READ_RETRIES=3
HL_SAFE_READ_BACKOFF_SECONDS=0.5
ENABLE_LIVE_TRADING=false
DEFAULT_SHADOW_MODE=true

SESSION_SECRET=
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:5173

# Local/staging only. Generate with: python scripts/generate_keys.py
KEK_PROVIDER=env
ENCRYPTION_KEY_B64=
# Production follower mainnet: KEK_PROVIDER=aws_kms and the KMS ARN/id below.
# A read-only mainnet master does NOT require a master signing key.
ENCRYPTION_KEY_REFERENCE=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Portfolio-based plans. Create one recurring Stripe Price for every period used.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Legacy monthly IDs are still accepted as fallbacks during migration:
# BASIC -> Starter, PRO -> Plus, ENTERPRISE -> Pro.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
TRIAL_DAYS=14

# Traxion Capital Intelligence (advisory/shadow first).
# Provider API keys belong only on the dedicated ai-intelligence-worker.
LLM_ENABLED=false
LLM_MODE=shadow
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# provider:model. The preferred model is tried first for every new AI analysis.
LLM_PREFERRED_MODEL=openai:gpt-5.6-luna
LLM_FALLBACK_MODELS=deepseek:deepseek-v4-flash,anthropic:claude-haiku-4-5
LLM_TIMEOUT_SECONDS=25
LLM_LOOKBACK_DAYS=30
# Legacy cache interval retained for compatibility; the dedicated worker uses
# master-event triggers as its primary scheduler.
LLM_ANALYSIS_INTERVAL_SECONDS=900
LLM_EVENT_QUEUE=hypercopy:ai:master-events
LLM_EVENT_DEBOUNCE_SECONDS=180
LLM_MIN_REFRESH_SECONDS=300
LLM_MAX_REFRESH_SECONDS=21600
LLM_FAILURE_RETRY_SECONDS=1800
LLM_EVENT_POLL_SECONDS=10
LLM_DB_FALLBACK_POLL_SECONDS=60

ADMIN_ADDRESSES=
SUPERADMIN_ADDRESSES=
RECONCILE_INTERVAL_SECONDS=60
LEDGER_STALE_SECONDS=120
WATCHER_LEASE_TTL_SECONDS=15
WATCHER_LEASE_RENEW_SECONDS=5
JOB_LEASE_SECONDS=120
MAX_JOB_RETRIES=5
METRICS_TOKEN=
SENTRY_DSN=
