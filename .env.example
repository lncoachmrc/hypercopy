# HyperCopy local development template. No real secret belongs in this file.
APP_ENV=development
APP_VERSION=dev
LOG_LEVEL=INFO
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://hypercopy:hypercopy@postgres:5432/hypercopy
REDIS_URL=redis://redis:6379/0

# Legacy fallback. New deployments should set MASTER/FOLLOWER explicitly.
HYPERLIQUID_NETWORK=testnet
HYPERLIQUID_MASTER_NETWORK=testnet
HYPERLIQUID_FOLLOWER_NETWORK=testnet
HYPERLIQUID_MASTER_ADDRESS=0x0000000000000000000000000000000000000000
HL_RATE_BUDGET_PER_MIN=1200
HL_ORDER_EXPIRES_AFTER_MS=15000
HL_AGENT_NAME=hypercopy
HL_MASTER_SNAPSHOT_TTL_SECONDS=2
HL_MASTER_SNAPSHOT_STALE_SECONDS=15
HL_WS_HEARTBEAT_SECONDS=30
HL_SAFE_READ_RETRIES=3
HL_SAFE_READ_BACKOFF_SECONDS=0.5
ENABLE_LIVE_TRADING=false
DEFAULT_SHADOW_MODE=true

# Traxion Capital Intelligence.
# Keep provider API keys only on the execution-worker service. The frontend
# receives only provider/model status through the authenticated API endpoint.
# Start in shadow: the AI decision is persisted and displayed but cannot alter
# trading targets. Switch to active only after TESTNET validation.
LLM_ENABLED=false
LLM_CAPITAL_MODE=shadow
LLM_PROVIDER_ORDER=openai,anthropic,deepseek
LLM_PREFERRED_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=12
LLM_MAX_OUTPUT_TOKENS=700
LLM_ANALYSIS_INTERVAL_SECONDS=300
LLM_STRATEGY_WINDOW_DAYS=30
LLM_RECOMMENDED_COVERAGE_PCT=90
LLM_MAX_TRACKING_ERROR_PCT=35
LLM_MAX_ALLOCATION_SCALE=1.5
LLM_DECISION_MAX_AGE_SECONDS=900

SESSION_SECRET=
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:5173

# Local/staging only. Generate with: python scripts/generate_keys.py
KEK_PROVIDER=env
ENCRYPTION_KEY_B64=
# Production follower mainnet: KEK_PROVIDER=aws_kms and the KMS ARN/id below.
# A read-only mainnet master does NOT require a master signing key.
ENCRYPTION_KEY_REFERENCE=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Portfolio-based plans. Create one recurring Stripe Price for every period used.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Legacy monthly IDs are still accepted as fallbacks during migration:
# BASIC -> Starter, PRO -> Plus, ENTERPRISE -> Pro.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
TRIAL_DAYS=14

ADMIN_ADDRESSES=
SUPERADMIN_ADDRESSES=
RECONCILE_INTERVAL_SECONDS=60
LEDGER_STALE_SECONDS=120
WATCHER_LEASE_TTL_SECONDS=15
WATCHER_LEASE_RENEW_SECONDS=5
JOB_LEASE_SECONDS=120
MAX_JOB_RETRIES=5
METRICS_TOKEN=
SENTRY_DSN=
